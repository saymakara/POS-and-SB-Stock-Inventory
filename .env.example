# Copy to .env.local for local development. Never commit real values.
#
# Supabase project (Project Settings -> API). The publishable / anon key is meant for the browser: the database's
# row-level security protects the data. Never put the service (secret) key in a VITE_ variable - every VITE_ value is
# copied into the public website code.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-key"

# Optional: error alerts to a Telegram chat. The bot token itself is entered in the portal's Settings, never here.
VITE_TELEGRAM_WEBHOOK_URL=""
VITE_TELEGRAM_CHAT_ID=""
