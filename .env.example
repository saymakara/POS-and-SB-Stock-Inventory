# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE POSTGRESQL & REALTIME CONFIGURATION
# ==============================================================================
# Obtain these from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ==============================================================================
# TEMPORARY TELEGRAM ERROR DEBUGGING WEBHOOK (ERROR-ONLY LOGGING)
# ==============================================================================
# Option A: Direct Webhook URL (e.g. Telegram Bot sendMessage endpoint or relay webhook)
VITE_TELEGRAM_WEBHOOK_URL=""
# Option B: Chat ID only. The Telegram bot token is entered in Settings (never put it in a VITE_ variable:
# every VITE_ value is copied into the public website code).
VITE_TELEGRAM_CHAT_ID=""
